# ==========================================
# MULTI-TIER WEB APPLICATION CONFIGURATION
# ==========================================

# SERVER & RUNTIME
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# JWT AUTHENTICATION
JWT_SECRET=super-secret-jwt-key-change-in-production-12345
JWT_EXPIRES_IN=1d

# MONGODB DATABASE (Optional: If omitted, runs in-memory seed store)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/multitier_db?retryWrites=true&w=majority

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# AWS DEPLOYMENT SECRETS (FOR GITHUB ACTIONS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=multi-tier-web-app-frontend
AWS_CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
EC2_HOST=ec2-12-34-56-78.compute-1.amazonaws.com
EC2_USERNAME=ubuntu
EC2_SSH_KEY=
